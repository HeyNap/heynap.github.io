{
  "name": "HeyNap",
  "short_name": "HeyNap",
  "description": "A baby sleep tracker that plans naps and bedtime around your baby.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "lang": "en",
  "display": "browser",
  "background_color": "#0E0F13",
  "theme_color": "#0E0F13",
  "icons": [
    { "src": "/assets/img/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/img/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/assets/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "prefer_related_applications": true,
  "related_applications": [
    { "platform": "play", "url": "https://play.google.com/store/apps/details?id=app.heynap.mobile", "id": "app.heynap.mobile" },
    { "platform": "itunes", "url": "https://apps.apple.com/app/idAPP_STORE_ID" }
  ]
}
